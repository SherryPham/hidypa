Bootstrap: docker
From: pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

%labels
    Author trpham
    Project Hi-DyPa
    Description Hierarchical Dynamic Parallel LLM Watermarking

%post
    # Update and install system dependencies
    apt-get update -q && apt-get install -y -q \
        git \
        && rm -rf /var/lib/apt/lists/*

    # Upgrade pip
    pip install --no-cache-dir --upgrade pip

    # Install project dependencies (excluding PySide6 — GUI not needed on HPC)
    pip install --no-cache-dir \
        transformers \
        accelerate \
        sentencepiece \
        numpy \
        pandas \
        matplotlib \
        seaborn \
        protobuf \
        nltk \
        openpyxl \
        psutil \
        datasets

    # Download NLTK data
    python -c "import nltk; nltk.download('punkt'); nltk.download('punkt_tab')"

%environment
    export PYTHONUNBUFFERED=1

%runscript
    exec python3 "$@"
